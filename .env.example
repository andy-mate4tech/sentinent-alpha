# Sentient Alpha backend
BOOTSTRAP_PAIRING_CODE=change-me-lab
ALLOW_INSECURE_NOAUTH=1
DATABASE_URL=postgresql+asyncpg://sentient:sentient@postgres:5432/sentient
REDIS_URL=redis://redis:6379/0
JWT_SECRET=dev-change-me-to-a-long-random-string
API_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Desk / LLM
# cli = kimi-cli / cursor-cli on the host (via LLM_BRIDGE_URL)
# deepseek | openai | google | anthropic = provider API keys
LLM_MODE=cli
LLM_CLI_PROVIDER=kimi
LLM_BRIDGE_URL=http://host.docker.internal:8099/v1
LLM_BRIDGE_API_KEY=sk-local-cli

TAURIC_MAX_JOBS_PER_DAY=20
BOOK_REVIEW_TOP_N=3
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_LLM_BACKEND_URL=http://host.docker.internal:8099/v1
TRADINGAGENTS_DEEP_THINK_LLM=kimi-cli
TRADINGAGENTS_QUICK_THINK_LLM=kimi-cli
TRADINGAGENTS_MEMORY_LOG_PATH=/data/trading_memory.md
TAURIC_CHECKPOINT=0
INSTALL_TAURIC=1

# Fill when ready (takes over from CLI bridge)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
SEC_EDGAR_USER_AGENT=SentientAlpha ops@mate4tech.au
